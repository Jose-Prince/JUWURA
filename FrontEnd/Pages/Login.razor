@using FrontEnd.Components
@inject ProjectService ProjectService
@page "/"
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<div class="login-container">
    <h1 class="size-font">Welcome back!</h1>

    <div class="form-container">
        <div class="form-group">
            <Field>
                <FieldLabel>Email address</FieldLabel>
                <TextEdit Placeholder="Email" Text="@mail" TextChanged="@onMailChanged" />
            </Field>
        </div>
        <div class="form-group">
            <Field>
                <FieldLabel>Password</FieldLabel>
                <TextEdit Placeholder="Password" Text="@password" TextChanged="@onPasswordChanged"/>
            </Field>
        </div>
        <Button Color="Color.Primary" Size="Size.Large" style="border-radius: 30px;" Clicked="@GetInLogin">
            <span style="white-space: pre;">               Get in              </span>
        </Button>
    </div>
    <div class="form-group">
        <Divider DividerType="DividerType.TextContent" Text="or"/>
    </div>
    <GoogleButton/>
    <h6 style="display: flex; gap: 10px;">Don't have an account? 
        <NavLink href="/auth/register">
            <p class="account-creation">Create account</p>
        </NavLink>
    </h6>
</div>

@code {
    string mail;
    string password;

    User user;

    Task onMailChanged(string value)
    {
        mail = value;

        return Task.CompletedTask;
    }

    Task onPasswordChanged(string value)
    {
        password = value;

        return Task.CompletedTask;
    }

    async Task GetInLogin()
    {
        if (mail != "" && password != "") 
        {
            user = await ProjectService.getUser(mail, password);
            Console.WriteLine(user);
        }
    }    
    private string email = "";
    private List<Usuario> data= [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Make the GET request
            data = await Http.GetFromJsonAsync<List<Usuario>>("http://35.169.88.222:8080/api/login/jau@gmail.com/123");
            Console.WriteLine($"Data loaded with {data[0]} users.");
            
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error fetching data: {ex.Message}");
        }
    }

    public class Usuario
    {
        public int Id { get; set; }
        public string usuario { get; set; }
        public string contrasena { get; set; }

        public Usuario(int id, string username, string password)
    {
        Id = id;
        usuario = username;
        contrasena = password;
    }
    }

}